# Variáveis para cadastrar na Vercel (Settings > Environment Variables).
# NUNCA coloque os valores reais neste arquivo nem no GitHub.

# Mercado Pago: Suas integrações > aplicação > credenciais de produção
MP_ACCESS_TOKEN=
# Mercado Pago: Webhooks > assinatura secreta
MP_WEBHOOK_SECRET=

# Resend: chave de API e remetente com o domínio verificado (ex.: Paralaxe <contato@seudominio.com.br>)
RESEND_API_KEY=
EMAIL_FROM=

# E-mail da Polyana, que recebe os avisos de pagamento e cancelamento
POLYANA_EMAIL=

# Upstash Redis (evita e-mail em duplicidade)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Só para teste local: 1 não envia e-mails de verdade
# DRY_RUN=1
