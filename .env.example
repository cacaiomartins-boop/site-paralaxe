# Variáveis para cadastrar na Vercel (Settings > Environment Variables).
# NUNCA coloque os valores reais neste arquivo nem no GitHub.

# --- Modo "verificado" (o mais simples; guia em PAGAMENTOS-VERIFICADO.md) ---
# Aplicação do Mercado Pago (conta do Caio): Client ID e Client Secret
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Senha longa inventada, que protege o link de autorização e o pagamento de teste de R$ 1
CONECTAR_CHAVE=
# Endereço final do site, sem barra no fim (ex.: https://paralaxe.com.br)
SITE_URL=
# Upstash Redis: guarda o token autorizado pela Polyana
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Alternativa ao clique de autorização: token fixo da conta da Polyana ---
# MP_ACCESS_TOKEN=

# --- Só para o modo "email" / "completo" (convite por e-mail, formulário próprio) ---
# MP_WEBHOOK_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=
# POLYANA_EMAIL=

# Só para teste local: 1 não envia e-mails de verdade
# DRY_RUN=1
